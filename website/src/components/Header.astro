---
const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Screenshots', href: '#screenshots' },
  { label: 'Get Started', href: '#getting-started' },
  { label: 'Docs', href: '#documentation' },
  { label: 'API', href: '#api' },
];
---

<header
  id="header"
  class="fixed top-0 z-50 w-full border-b border-transparent bg-white/80 backdrop-blur-lg transition-colors duration-300"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8" aria-label="Main navigation">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-2" aria-label="WireGUI home">
      <img src="/wiregui/img/wiregui.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span class="text-xl font-bold text-navy-950">WireGUI</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-8 md:flex" role="list">
      {navLinks.map(({ label, href }) => (
        <li>
          <a href={href} class="text-sm font-medium text-slate-600 transition-colors hover:text-navy-700">
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="https://github.com/bartei/wiregui"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-navy-950 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-navy-900"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          GitHub
        </a>
      </li>
    </ul>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="inline-flex items-center rounded-lg p-2 text-slate-600 hover:bg-slate-100 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white md:hidden" role="menu">
    <div class="space-y-1 px-4 py-3">
      {navLinks.map(({ label, href }) => (
        <a href={href} class="block rounded-lg px-3 py-2 text-base font-medium text-slate-600 hover:bg-slate-100" role="menuitem">
          {label}
        </a>
      ))}
      <a
        href="https://github.com/bartei/wiregui"
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-lg px-3 py-2 text-base font-medium text-slate-600 hover:bg-slate-100"
        role="menuitem"
      >
        GitHub
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });

  // Close mobile menu on link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
    });
  });

  // Header border on scroll
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header?.classList.add('border-slate-200');
    } else {
      header?.classList.remove('border-slate-200');
    }
  });
</script>