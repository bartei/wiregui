---
const endpoints = [
  { method: 'GET', path: '/api/v0/users/', desc: 'List all users' },
  { method: 'POST', path: '/api/v0/users/', desc: 'Create user' },
  { method: 'GET', path: '/api/v0/devices/', desc: 'List all devices' },
  { method: 'POST', path: '/api/v0/devices/', desc: 'Create device' },
  { method: 'GET', path: '/api/v0/rules/', desc: 'List firewall rules' },
  { method: 'POST', path: '/api/v0/rules/', desc: 'Create rule' },
  { method: 'GET', path: '/api/v0/configuration/', desc: 'Get configuration' },
  { method: 'PUT', path: '/api/v0/configuration/', desc: 'Update configuration' },
];

const methodColors: Record<string, string> = {
  GET: 'bg-emerald-50 text-emerald-700',
  POST: 'bg-blue-50 text-blue-700',
  PUT: 'bg-amber-50 text-amber-700',
  DELETE: 'bg-red-50 text-red-700',
};
---

<section id="api" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="grid items-start gap-12 lg:grid-cols-2">
        <!-- Left: description -->
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-navy-950 sm:text-4xl">
            REST API
          </h2>
          <p class="mt-4 text-lg text-slate-600">
            Full programmatic access via <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm font-medium text-navy-700">/api/v0</code>.
            Manage users, devices, rules, and configuration with API tokens.
          </p>

          <!-- Example -->
          <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-navy-950">
            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2">
              <span class="h-3 w-3 rounded-full bg-red-500/60" aria-hidden="true"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-500/60" aria-hidden="true"></span>
              <span class="h-3 w-3 rounded-full bg-green-500/60" aria-hidden="true"></span>
              <span class="ml-2 text-xs text-slate-400">Create a device</span>
            </div>
            <pre class="overflow-x-auto p-4 text-sm leading-relaxed text-slate-300"><code>curl -X POST https://vpn.example.com/api/v0/devices/ \
  -H "Authorization: Bearer wgui_xxxx" \
  -H "Content-Type: application/json" \
  -d '&#123;"name": "laptop", "user_id": 1&#125;'</code></pre>
          </div>

          <p class="mt-4 text-sm text-slate-600">
            Generate API tokens from the
            <a href="#screenshots" class="font-medium text-navy-700 underline underline-offset-2 hover:text-navy-900">Account Settings</a>
            page. Tokens use the <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-navy-700">Authorization: Bearer</code> header.
          </p>
        </div>

        <!-- Right: endpoint list -->
        <div class="rounded-2xl border border-slate-200 bg-white">
          <div class="border-b border-slate-200 px-5 py-4">
            <h3 class="font-semibold text-navy-950">Endpoints</h3>
            <p class="text-sm text-slate-500">All endpoints require API token authentication</p>
          </div>
          <div class="divide-y divide-slate-100">
            <div class="px-5 py-3">
              <div class="flex items-center gap-3">
                <span class="inline-flex w-12 justify-center rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-bold text-emerald-700">GET</span>
                <code class="text-sm text-slate-700">/api/health</code>
                <span class="ml-auto text-xs text-slate-400">no auth</span>
              </div>
            </div>
            {endpoints.map(({ method, path, desc }) => (
              <div class="px-5 py-3">
                <div class="flex items-center gap-3">
                  <span class={`inline-flex w-12 justify-center rounded-md px-2 py-0.5 text-xs font-bold ${methodColors[method]}`}>{method}</span>
                  <code class="text-sm text-slate-700">{path}</code>
                </div>
                <p class="mt-0.5 pl-15 text-xs text-slate-500">{desc}</p>
              </div>
            ))}
          </div>
          <div class="border-t border-slate-200 px-5 py-3 text-center">
            <span class="text-xs text-slate-400">
              + PUT, DELETE for each resource
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>