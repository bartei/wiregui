<section id="features" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-navy-950 sm:text-4xl">
        Everything you need to manage your VPN
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Built for teams and individuals who want full control over their VPN infrastructure.
      </p>
    </div>

    <div class="mx-auto mt-16 grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {features.map(({ title, description, icon }) => (
        <article class="group rounded-2xl border border-slate-200 p-6 transition-shadow hover:shadow-lg">
          <div class="mb-4 inline-flex rounded-xl bg-navy-50 p-3 text-navy-700 transition-colors group-hover:bg-navy-100">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-navy-950">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>