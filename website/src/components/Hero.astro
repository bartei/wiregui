      <div class="rounded-2xl border border-white/10 bg-white/5 p-2 shadow-2xl backdrop-blur-sm">
        <img
          src="/wiregui/img/02_devices.png"
          alt="WireGUI devices dashboard showing VPN peers with status, IP addresses, and traffic statistics"
          class="rounded-xl"
          width="1400"
          height="900"
          loading="eager"
        />
